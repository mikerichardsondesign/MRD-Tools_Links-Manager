<Project>

  <!--
    Builds the Autodesk App Store style bundle for every supported Revit year.

      dotnet msbuild MRDTools.csproj -t:Bundle        artifacts\External Access Links Manager.bundle.zip
                                                      (the unzipped bundle is staged in %LOCALAPPDATA%\MRD-Tools\bundle)
      dotnet msbuild MRDTools.csproj -t:DeployLocal   also installs it per-user in %APPDATA%\Autodesk\ApplicationPlugins

    Add -p:BundleConfiguration=Debug to bundle Debug builds instead of Release.
    Revit must be closed for DeployLocal, or the copy fails on the locked DLL.
  -->

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <BundleName>External Access Links Manager.bundle</BundleName>
    <BundleConfiguration Condition="'$(BundleConfiguration)' == ''">Release</BundleConfiguration>
    <!-- Staged outside OneDrive: its sync holds files open, which makes clearing the last bundle fail -->
    <BundleStageRoot Condition="'$(BundleStageRoot)' == ''">$(LOCALAPPDATA)\MRD-Tools\bundle\</BundleStageRoot>
    <BundleStageDir>$(BundleStageRoot)$(BundleName)\</BundleStageDir>
    <BundleZip>$(RepoRoot)artifacts\$(BundleName).zip</BundleZip>
    <DeployRoot Condition="'$(DeployRoot)' == ''">$(APPDATA)\Autodesk\ApplicationPlugins\</DeployRoot>
  </PropertyGroup>

  <ItemGroup>
    <BundleRevitYear Include="24;25;26;27" />

    <!-- Everything that ships next to the add-in DLL. Anything else in bin stays out of the bundle. -->
    <BundleShipFile Include="MRD-Tools.dll;MRD-Tools.pdb;MRD-Tools.addin;EPPlus.dll;MRD-Links-16x16.png;MRD-Links-32x32.png" />

    <!-- EPPlus's configuration dependencies for Revit 2025/2026 (see the csproj). Where Revit has its own copy, Revit's wins. -->
    <BundleShipFile Condition="'$(TargetFramework)' == 'net8.0-windows'"
                    Include="Microsoft.Extensions.Configuration.dll;Microsoft.Extensions.Configuration.Abstractions.dll;Microsoft.Extensions.Configuration.FileExtensions.dll;Microsoft.Extensions.Configuration.Json.dll;Microsoft.Extensions.FileProviders.Abstractions.dll;Microsoft.Extensions.FileProviders.Physical.dll;Microsoft.Extensions.FileSystemGlobbing.dll;Microsoft.Extensions.Primitives.dll" />
  </ItemGroup>

  <!-- Runs after each year's build when Bundle asks for it (StageBundle=true) -->
  <Target Name="StageBundleYear" AfterTargets="Build" Condition="'$(StageBundle)' == 'true'">
    <ItemGroup>
      <_BundleYearFile Include="@(BundleShipFile->'$(TargetDir)%(Identity)')" />
    </ItemGroup>
    <Error Condition="!Exists('%(_BundleYearFile.FullPath)')" Text="Bundle: %(_BundleYearFile.Filename)%(_BundleYearFile.Extension) is missing from $(TargetDir)" />
    <Copy SourceFiles="@(_BundleYearFile)" DestinationFolder="$(BundleStageDir)Contents\R$(RevitVersion)\" />
  </Target>

  <Target Name="Bundle">
    <RemoveDir Directories="$(BundleStageRoot)" />

    <!--
      Restore and build each year in-process. (Not via Exec: that runs through cmd.exe, which some machines block.)
      The restore gets an extra property so its evaluation isn't reused for the build.
    -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore"
             Properties="Configuration=$(BundleConfiguration) R%(BundleRevitYear.Identity);_BundleRestore=true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="Configuration=$(BundleConfiguration) R%(BundleRevitYear.Identity);StageBundle=true" />

    <PropertyGroup>
      <_PackageContents>$([System.IO.File]::ReadAllText('$(RepoRoot)bundle\PackageContents.xml').Replace('__VERSION__', '$(Version)'))</_PackageContents>
    </PropertyGroup>
    <WriteLinesToFile File="$(BundleStageDir)PackageContents.xml" Lines="$([MSBuild]::Escape($(_PackageContents)))" Overwrite="true" Encoding="UTF-8" />

    <ItemGroup>
      <_BundleAsset Include="$(RepoRoot)bundle\Contents\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundleAsset)" DestinationFiles="@(_BundleAsset->'$(BundleStageDir)Contents\%(RecursiveDir)%(Filename)%(Extension)')" />

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(BundleZip)'))" />
    <ZipDirectory SourceDirectory="$(BundleStageRoot)" DestinationFile="$(BundleZip)" Overwrite="true" />
    <Message Importance="high" Text="Bundle $(Version) ($(BundleConfiguration)): $(BundleZip)" />
  </Target>

  <Target Name="DeployLocal" DependsOnTargets="Bundle">
    <!-- A second copy of the bundle means two add-ins with the same AddInId, and Revit refuses the duplicate -->
    <Warning Condition="Exists('$(ProgramData)\Autodesk\ApplicationPlugins\$(BundleName)')"
             Text="A machine-wide copy is also installed in $(ProgramData)\Autodesk\ApplicationPlugins. Revit 2024-2026 will see both; uninstall that copy." />
    <Warning Condition="Exists('$(ProgramW6432)\Autodesk\ApplicationPlugins\$(BundleName)')"
             Text="A machine-wide copy is also installed in $(ProgramW6432)\Autodesk\ApplicationPlugins. Revit 2027 will see both; uninstall that copy." />

    <RemoveDir Directories="$(DeployRoot)$(BundleName)" />
    <ItemGroup>
      <_StagedBundleFile Include="$(BundleStageDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedBundleFile)" DestinationFiles="@(_StagedBundleFile->'$(DeployRoot)$(BundleName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Deployed to $(DeployRoot)$(BundleName)" />
  </Target>

</Project>
