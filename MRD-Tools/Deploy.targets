<Project>

  <!--
    Stages the add-in for every supported Revit year and builds its per-user setup:

      dotnet build MRDTools.csproj -t:Deploy

    Everything lands in C:\Temp\LinksManager-Deploy\Public\, laid out like the folder it installs into, plus the
    setup exe and the bundle zipped for a GitHub release. It never writes to a live add-in folder, and the
    flavour's folder is emptied first.

      C:\Temp\LinksManager-Deploy\Public\
        ApplicationPlugins\External Access Links Manager.bundle\    copies into %APPDATA%\Autodesk\ApplicationPlugins
        External Access Links Manager.bundle.zip
        LinksManager-<version>-Setup.exe

      Stage elsewhere:      -p:StageRoot=D:\somewhere   (each flavour's subfolder is emptied first)
      Stage Debug builds:   -p:BundleConfiguration=Debug
      Skip the setup:       -p:BuildInstaller=false

    Other flavours: point ExtraDeployTargets, in Deploy.local.props beside this file (not committed), at a targets
    file of your own. For its -p:Flavour=<name> it adds BundleRevitYear items (each with the Location folder its
    bundle is staged under) and sets SetupName and InstallerScript, plus InnoExtraArguments if it needs them.

    Nothing here uses Exec, which runs through cmd.exe and so fails where that is locked down: the years build
    through the MSBuild task, and the Inno Setup compiler runs through RunTool below.
  -->

  <Import Project="Deploy.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Deploy.local.props')" />

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <BundleName>External Access Links Manager.bundle</BundleName>
    <Flavour Condition="'$(Flavour)' == ''">Public</Flavour>
    <BundleConfiguration Condition="'$(BundleConfiguration)' == ''">Release</BundleConfiguration>
    <StageRoot Condition="'$(StageRoot)' == ''">C:\Temp\LinksManager-Deploy</StageRoot>
    <FlavourStage>$(StageRoot)\$(Flavour)</FlavourStage>
    <BuildInstaller Condition="'$(BuildInstaller)' == ''">true</BuildInstaller>
    <SetupName Condition="'$(Flavour)' == 'Public'">LinksManager-$(Version)-Setup</SetupName>
    <InstallerScript Condition="'$(Flavour)' == 'Public'">$(RepoRoot)installer\LinksManager.iss</InstallerScript>
    <InnoCompiler Condition="'$(InnoCompiler)' == '' And Exists('$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe')">$(LOCALAPPDATA)\Programs\Inno Setup 6\ISCC.exe</InnoCompiler>
    <InnoCompiler Condition="'$(InnoCompiler)' == '' And Exists('$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe')">$(MSBuildProgramFiles32)\Inno Setup 6\ISCC.exe</InnoCompiler>
  </PropertyGroup>

  <!-- The years in each flavour, and the folder each one's bundle is staged under -->
  <ItemGroup Condition="'$(Flavour)' == 'Public'">
    <BundleRevitYear Include="2024" Short="24" Location="ApplicationPlugins" />
    <BundleRevitYear Include="2025" Short="25" Location="ApplicationPlugins" />
    <BundleRevitYear Include="2026" Short="26" Location="ApplicationPlugins" />
    <BundleRevitYear Include="2027" Short="27" Location="ApplicationPlugins" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything that ships next to the add-in DLL. Anything else in bin stays out of the bundle. -->
    <BundleShipFile Include="MRD-Tools.dll;MRD-Tools.pdb;MRD-Tools.addin;EPPlus.dll;MRD-Links-16x16.png;MRD-Links-32x32.png" />

    <!-- EPPlus's configuration dependencies for Revit 2025/2026 (see the csproj). Where Revit has its own copy, Revit's wins. -->
    <BundleShipFile Condition="'$(TargetFramework)' == 'net8.0-windows'"
                    Include="Microsoft.Extensions.Configuration.dll;Microsoft.Extensions.Configuration.Abstractions.dll;Microsoft.Extensions.Configuration.FileExtensions.dll;Microsoft.Extensions.Configuration.Json.dll;Microsoft.Extensions.FileProviders.Abstractions.dll;Microsoft.Extensions.FileProviders.Physical.dll;Microsoft.Extensions.FileSystemGlobbing.dll;Microsoft.Extensions.Primitives.dll" />
  </ItemGroup>

  <!-- Runs a program directly and logs its output: what Exec would do, without going through cmd.exe -->
  <UsingTask TaskName="RunTool" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FileName ParameterType="System.String" Required="true" />
      <Arguments ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Log.LogMessage(MessageImportance.Low, "{0} {1}", FileName, Arguments);
        var startInfo = new ProcessStartInfo(FileName, Arguments)
        {
            UseShellExecute = false,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            CreateNoWindow = true,
        };
        using (var process = Process.Start(startInfo))
        {
            var stderr = process.StandardError.ReadToEndAsync();
            string stdout = process.StandardOutput.ReadToEnd();
            process.WaitForExit();
            bool failed = process.ExitCode != 0;
            foreach (string line in (stdout + "\n" + stderr.Result).Split('\n'))
            {
                if (line.Trim().Length == 0) continue;
                if (failed) Log.LogError("{0}", line.TrimEnd());
                else Log.LogMessage(MessageImportance.Normal, "{0}", line.TrimEnd());
            }
            if (failed)
                Log.LogError("{0} exited with code {1}", Path.GetFileName(FileName), process.ExitCode);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Runs after each year's build when Deploy asks for it, copying that year's files into its bundle -->
  <Target Name="StageBundleYear" AfterTargets="Build" Condition="'$(BundleYearDir)' != ''">
    <ItemGroup>
      <_BundleYearFile Include="@(BundleShipFile->'$(TargetDir)%(Identity)')" />
    </ItemGroup>
    <Error Condition="!Exists('%(_BundleYearFile.FullPath)')" Text="Deploy: %(_BundleYearFile.Filename)%(_BundleYearFile.Extension) is missing from $(TargetDir)" />
    <Copy SourceFiles="@(_BundleYearFile)" DestinationFolder="$(BundleYearDir)" />
  </Target>

  <Target Name="Deploy" DependsOnTargets="_DeployCheck;_DeployBuildYears;_DeployBundles;_DeployZip;_DeployInstaller">
    <Message Importance="high" Text="  " />
    <Message Importance="high" Text="Staged at: $(FlavourStage)" />
    <Message Importance="high" Condition="'$(Flavour)' == 'Public' And '$(BuildInstaller)' == 'true'" Text="  Setup, per user:      $(SetupName).exe" />
    <Message Importance="high" Condition="'$(Flavour)' == 'Public'" Text="  GitHub release:       the setup + $(BundleName).zip" />
    <Message Importance="high" Condition="'$(Flavour)' == 'Public'" Text="  Manual copy instead:  ApplicationPlugins\$(BundleName)\  into  %25APPDATA%25\Autodesk\ApplicationPlugins" />
  </Target>

  <Target Name="_DeployCheck">
    <Error Condition="'$(ExtraDeployTargets)' != '' And !Exists('$(ExtraDeployTargets)')" Text="ExtraDeployTargets points at a file that doesn't exist: $(ExtraDeployTargets)" />
    <Error Condition="'@(BundleRevitYear)' == ''" Text="Unknown flavour '$(Flavour)'. Public is built in; others come from the targets file named by ExtraDeployTargets." />
    <Error Condition="'$(BuildInstaller)' == 'true' And '$(InstallerScript)' == ''" Text="Flavour '$(Flavour)' has no InstallerScript. Set one, or skip the setup with -p:BuildInstaller=false." />
    <Error Condition="'$(BuildInstaller)' == 'true' And !Exists('$(InnoCompiler)')" Text="Inno Setup 6 was not found. Install it (winget install JRSoftware.InnoSetup --scope user), pass -p:InnoCompiler=&lt;path to ISCC.exe&gt;, or skip the setup with -p:BuildInstaller=false." />

    <!-- An all-users copy as well as a per-user one means two add-ins with the same AddInId, and Revit refuses one -->
    <Warning Condition="'$(Flavour)' == 'Public' And (Exists('$(ProgramData)\Autodesk\ApplicationPlugins\$(BundleName)') Or Exists('$(ProgramW6432)\Autodesk\ApplicationPlugins\$(BundleName)'))"
             Text="The add-in is installed for all users on this machine. The Public setup will refuse to install alongside it." />

    <RemoveDir Directories="$(FlavourStage)" />
    <Message Importance="high" Text="Staging External Access Links Manager $(Version) ($(Flavour), $(BundleConfiguration)) for Revit @(BundleRevitYear->'%(Identity)', ', ')" />
  </Target>

  <!--
    Restore, then build, each year in-process, copying its files into the bundle for its location.
    The restore gets an extra property so its evaluation isn't reused for the build.
  -->
  <Target Name="_DeployBuildYears">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore"
             Properties="Configuration=$(BundleConfiguration) R%(BundleRevitYear.Short);_BundleRestore=true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="Configuration=$(BundleConfiguration) R%(BundleRevitYear.Short);BundleYearDir=$(FlavourStage)\%(BundleRevitYear.Location)\$(BundleName)\Contents\R%(BundleRevitYear.Identity)\" />
  </Target>

  <!-- Once per location: its PackageContents.xml, listing only the years staged there, plus the shared Contents -->
  <Target Name="_DeployBundles" Outputs="%(BundleRevitYear.Location)">
    <PropertyGroup>
      <_BundleDir>$(FlavourStage)\%(BundleRevitYear.Location)\$(BundleName)\</_BundleDir>
      <_ComponentTemplate>$([System.IO.File]::ReadAllText('$(RepoRoot)bundle\PackageContents.Component.xml'))</_ComponentTemplate>
    </PropertyGroup>
    <!-- Each year in this bundle gets its Components block as metadata, then they're joined. (A property can't
         collect them: batched property updates don't see each other.) Years are four digits and in order, so the
         first and last four characters of the joined list are the series range. -->
    <ItemGroup>
      <BundleRevitYear>
        <Component>$(_ComponentTemplate.Replace('__YEAR__', '%(Identity)'))</Component>
      </BundleRevitYear>
    </ItemGroup>
    <PropertyGroup>
      <_Components>@(BundleRevitYear->'%(Component)', '')</_Components>
      <_Years>@(BundleRevitYear->'%(Identity)', '')</_Years>
      <_SeriesMin>$(_Years.Substring(0, 4))</_SeriesMin>
      <_SeriesMax>$(_Years.Substring($([MSBuild]::Subtract($(_Years.Length), 4))))</_SeriesMax>
      <_PackageContents>$([System.IO.File]::ReadAllText('$(RepoRoot)bundle\PackageContents.xml').Replace('__COMPONENTS__', '$(_Components.TrimEnd())').Replace('__SERIES_MIN__', '$(_SeriesMin)').Replace('__SERIES_MAX__', '$(_SeriesMax)').Replace('__VERSION__', '$(Version)'))</_PackageContents>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BundleDir)PackageContents.xml" Lines="$([MSBuild]::Escape($(_PackageContents)))" Overwrite="true" Encoding="UTF-8" />

    <ItemGroup>
      <_BundleAsset Remove="@(_BundleAsset)" />
      <_BundleAsset Include="$(RepoRoot)bundle\Contents\**\*;$(RepoRoot)LICENSE;$(RepoRoot)THIRD-PARTY-NOTICES.md;$(RepoRoot)licenses\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundleAsset)" DestinationFiles="@(_BundleAsset->'$(_BundleDir)Contents\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Public only: the bundle zipped with its .bundle folder at the top, for a GitHub release -->
  <Target Name="_DeployZip" Condition="'$(Flavour)' == 'Public'">
    <ZipDirectory SourceDirectory="$(FlavourStage)\ApplicationPlugins" DestinationFile="$(FlavourStage)\$(BundleName).zip" Overwrite="true" />
  </Target>

  <!-- The setup exe, from the flavour's Inno Setup script -->
  <Target Name="_DeployInstaller" Condition="'$(BuildInstaller)' == 'true'">
    <PropertyGroup>
      <_InnoArguments>/Q &quot;/DFlavour=$(Flavour)&quot; &quot;/DAppVersion=$(Version)&quot; &quot;/DStageDir=$(FlavourStage)&quot; &quot;/DRepoRoot=$(RepoRoot.TrimEnd('\'))&quot; &quot;/O$(FlavourStage)&quot; &quot;/F$(SetupName)&quot; $(InnoExtraArguments)</_InnoArguments>
    </PropertyGroup>
    <RunTool FileName="$(InnoCompiler)" Arguments="$(_InnoArguments) &quot;$(InstallerScript)&quot;" />
  </Target>

  <!-- Any other flavours, last so they can set what's above for themselves -->
  <Import Project="$(ExtraDeployTargets)" Condition="'$(ExtraDeployTargets)' != '' And Exists('$(ExtraDeployTargets)')" />

</Project>
