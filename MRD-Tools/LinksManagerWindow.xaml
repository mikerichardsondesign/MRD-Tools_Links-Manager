<Window x:Class="MRDTools.LinksManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MRDTools"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="External Access Links Manager"
        Width="1280" Height="820" MinWidth="1180" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MRD-Tools;component/Themes/LinksManagerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <x:Array x:Key="PathTypes" Type="sys:String">
                <sys:String>Relative</sys:String>
                <sys:String>Absolute</sys:String>
            </x:Array>

            <!-- A Server link's path type can't be changed, so it's shown as text instead of a list -->
            <Style x:Key="FixedPathTypeText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanChangePathType}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Changed links get an Amber row, and links whose file isn't found a red one, which wins: a changed link
                 keeps its Amber bar. Selection still wins over both. -->
            <Style x:Key="LinkRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileStatus}" Value="{x:Static local:LinkFileStatus.Missing}">
                        <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StateText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DesiredState}" Value="NotFound">
                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A tick when the path on next open finds a file, a red warning when it doesn't, and a dash for a server or cloud model -->
            <Style x:Key="FileStatusIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,4" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FileStatus}" Value="{x:Static local:LinkFileStatus.Found}">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileStatus}" Value="{x:Static local:LinkFileStatus.Missing}">
                        <Setter Property="Text" Value="&#xE7BA;" />
                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileStatus}" Value="{x:Static local:LinkFileStatus.Checking}">
                        <Setter Property="Text" Value="&#xE72C;" />
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileStatus}" Value="{x:Static local:LinkFileStatus.NotChecked}">
                        <Setter Property="Text" Value="&#xE738;" />
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    </DataTrigger>
                    <!-- Other references aren't looked for, and say nothing -->
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LinkKind.Other}">
                        <Setter Property="Text" Value="" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A Revit link's version: red when it's later than this Revit, so it won't load; amber for a local copy -->
            <Style x:Key="SavedInText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FileInfo.IsLocal}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileInfo.IsLaterVersion}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileInfo.Text}" Value="Unreadable">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NewPathText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPathChanged}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <DockPanel Grid.Row="0" Margin="4,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="15"
                        ToolTip="Help (F1)" Click="Help_Click" />
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="0,0,10,0" />
                <TextBlock Text="EXTERNAL ACCESS LINKS MANAGER" Style="{StaticResource TitleText}" />
            </DockPanel>

            <!-- Instructions -->
            <ContentControl Grid.Row="1" Style="{StaticResource Banner}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Add projects, review and change their links, then click MAKE CHANGES. Nothing is written to a project until you do, and it must not be open in Revit." />
                </StackPanel>
            </ContentControl>

            <!-- Projects: sized to its rows, so one project leaves more room for the links -->
            <ContentControl Grid.Row="3" Style="{StaticResource Card}" MinHeight="120" MaxHeight="230">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" ToolTip="Add one or more Revit projects" Click="AddFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,6,0" />
                                        <TextBlock Text="ADD FILES" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButton}" ToolTip="Add every Revit project in a folder" Click="AddFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,6,0" />
                                        <TextBlock Text="ADD FOLDER" />
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="IncludeSubfolders" Content="Include subfolders" Margin="4,0,16,0"
                                          ToolTip="Add Folder also adds the projects in its subfolders" />
                                <Button Style="{StaticResource ToolButton}" Margin="0" ToolTip="Remove the selected projects from the list" Click="Remove_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,6,0" />
                                        <TextBlock Text="REMOVE" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROJECTS" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="ProjectCount" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <DataGrid x:Name="ProjectsGrid" Margin="1,0,1,4" SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PROCESS" Width="80" SortMemberPath="Process">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Process, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      ToolTip="Show this project's links, and write them with Make Changes" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PROJECT" Binding="{Binding Name}" Width="260" IsReadOnly="True" />
                                <DataGridTextColumn Header="FOLDER" Binding="{Binding Folder}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="LAST SAVED" Binding="{Binding LastSaved}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="LINKS" Binding="{Binding LinkCount}" Width="64" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="CHANGES" Width="120" SortMemberPath="ChangeCount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ChangesText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="260" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel ToolTip="{Binding Status}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,6,0"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="ProjectsHint" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,36,0,12"
                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                   Text="Add projects with ADD FILES or ADD FOLDER, or drop .rvt files and folders onto this window." />
                    </Grid>
                </DockPanel>
            </ContentControl>

            <!-- Links -->
            <ContentControl Grid.Row="5" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <TextBlock x:Name="LinksSummary" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                            <TextBlock Text="LINKS" Style="{StaticResource SectionTitleText}" />
                        </DockPanel>
                    </Border>

                    <TabControl x:Name="KindTabs" DockPanel.Dock="Top" Style="{StaticResource TabStrip}" SelectionChanged="KindTabs_SelectionChanged">
                        <TabItem x:Name="TabRevit" Tag="{x:Static local:LinkKind.Revit}" />
                        <TabItem x:Name="TabCad" Tag="{x:Static local:LinkKind.Cad}" />
                        <TabItem x:Name="TabDwf" Tag="{x:Static local:LinkKind.Dwf}" />
                        <TabItem x:Name="TabOther" Tag="{x:Static local:LinkKind.Other}"
                                 ToolTip="Keynote tables, assembly code tables, decals and other references: shown as last saved, and not changed" />
                    </TabControl>

                    <DockPanel x:Name="LinkTools" DockPanel.Dock="Top" Margin="10,8,10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Content="REPATH SELECTED…" Click="RepathSelected_Click"
                                    ToolTip="Point the selected links at the files of the same name in another folder" />
                            <Button Style="{StaticResource ToolButton}" Content="REPATH ALL TO FOLDER…" Click="RepathAll_Click"
                                    ToolTip="Point every link on this tab at the files of the same name in another folder" />
                            <Button Style="{StaticResource ToolButton}" Content="FIND &amp; REPLACE…" Click="FindReplace_Click"
                                    ToolTip="Replace text in the paths of the selected links, this tab's links or every link (Ctrl+H)" />
                            <Button Style="{StaticResource ToolButton}" Click="Reset_Click"
                                    ToolTip="Undo your changes to the selected links, or to every link on this tab if none are selected">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,6,0" />
                                    <TextBlock Text="RESET CHANGES" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="4,4,10,4" Background="{StaticResource DividerBrush}" />
                            <Button Style="{StaticResource ToolButton}" Content="LOAD SELECTED" Click="LoadSelected_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="UNLOAD SELECTED" Click="UnloadSelected_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="LOAD ALL" Click="LoadAll_Click" ToolTip="Load every link on this tab" />
                            <Button Style="{StaticResource ToolButton}" Content="UNLOAD ALL" Click="UnloadAll_Click" ToolTip="Unload every link on this tab" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="LinksGrid" Margin="1,0,1,4" RowStyle="{StaticResource LinkRowStyle}" SelectionMode="Extended"
                              BeginningEdit="LinksGrid_BeginningEdit" CellEditEnding="LinksGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="6" MinWidth="6" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource AccentDarkBrush}"
                                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ProjectColumn" Header="PROJECT" Binding="{Binding ProjectName}" Width="150" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="LINK NAME" Width="150" SortMemberPath="DesiredName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- A lock for a link that can't be changed here, saying why -->
                                        <DockPanel Background="Transparent" ToolTip="{Binding ReadOnlyReason}">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,0,6,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DesiredName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PATH TYPE" Width="92" SortMemberPath="DesiredPathType">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding DesiredPathType}" Style="{StaticResource FixedPathTypeText}" />
                                            <ComboBox ItemsSource="{StaticResource PathTypes}"
                                                      SelectedItem="{Binding DesiredPathType, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding CanChangePathType, Converter={StaticResource BoolToVisibility}}"
                                                      SelectionChanged="PathType_SelectionChanged"
                                                      ToolTip="Relative paths are worked out from the project's folder. Changing this converts the path to match." />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LOADED" Width="66" SortMemberPath="DesiredLoaded">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DesiredLoaded, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding IsEditable}" ToolTip="Load this link the next time the project opens" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATE" Width="80" SortMemberPath="DesiredState">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DesiredState}" Style="{StaticResource StateText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FOUND" Width="62" SortMemberPath="FileStatus">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeader}">
                                        <Setter Property="ToolTip" Value="Whether the path on next open finds a file, looked for from this computer" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource FileStatusIcon}" ToolTip="{Binding FileStatusText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="SavedInColumn" Header="SAVED IN" Width="104" SortMemberPath="FileInfo.Text">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeader}">
                                        <Setter Property="ToolTip" Value="The Revit version each linked model was saved in, and whether it's a central model or a local copy" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileInfo.Text}" ToolTip="{Binding FileInfo.ToolTip}" Style="{StaticResource SavedInText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PATH ON NEXT OPEN" Width="*" SortMemberPath="DesiredPath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding DesiredPath}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource CellButton}"
                                                    Content="&#xE712;" ToolTip="Browse for the linked file" Click="BrowseLink_Click"
                                                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DesiredPath}" Style="{StaticResource NewPathText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DesiredPath, UpdateSourceTrigger=Explicit}" Loaded="PathEditor_Loaded" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LAST SAVED PATH" Width="*" SortMemberPath="LastSavedPath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastSavedPath}" ToolTip="{Binding LastSavedPath}" Style="{StaticResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FILE DATE" Binding="{Binding LastSavedTime}" Width="118" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </ContentControl>

            <!-- Footer -->
            <ContentControl Grid.Row="7" Style="{StaticResource Banner}" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="CLOSE" Width="100" Click="Close_Click" />
                    <Button x:Name="TextReportButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Margin="14,0,6,0" Click="TextReport_Click"
                            ToolTip="A text file listing every link, as last saved and as it will be. Nothing is written to the projects.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,6,0" />
                            <TextBlock Text="TEXT REPORT" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExcelButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="ExportExcel_Click"
                            ToolTip="An Excel workbook listing every link, as last saved and as it will be. Nothing is written to the projects.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;" Margin="0,0,6,0" />
                            <TextBlock Text="EXPORT TO EXCEL" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="ImportExcel_Click"
                            ToolTip="Read paths, path types and load states back from an exported workbook you've edited in Excel. Nothing is written to the projects until you click Make Changes.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,6,0" />
                            <TextBlock Text="IMPORT FROM EXCEL…" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="MakeChangesButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="MAKE CHANGES"
                            Click="MakeChanges_Click" ToolTip="Write the links of the projects ticked to Process" />
                    <Border x:Name="ChangesBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0,0,12,0">
                        <TextBlock x:Name="ChangesBadgeText" />
                    </Border>
                    <CheckBox x:Name="WriteAllLinks" DockPanel.Dock="Right" Content="Write all links, not just changed ones" Margin="0,0,20,0" />
                    <Border />
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
