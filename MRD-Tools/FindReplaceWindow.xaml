<Window x:Class="MRDTools.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find and Replace in Paths"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MRD-Tools;component/Themes/LinksManagerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <StackPanel Margin="20,16,20,18">
            <TextBlock Text="FIND" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FindBox" MinHeight="30" TextChanged="Criteria_Changed" />

            <TextBlock Text="REPLACE WITH" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
            <TextBox x:Name="ReplaceBox" MinHeight="30" />

            <CheckBox x:Name="MatchCase" Content="Match case" Margin="0,10,0,0" HorizontalAlignment="Left"
                      Checked="Criteria_Changed" Unchecked="Criteria_Changed" />

            <TextBlock Text="LOOK IN" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
            <RadioButton x:Name="LookInSelected" GroupName="LookIn" HorizontalAlignment="Left" Checked="Criteria_Changed" />
            <RadioButton x:Name="LookInTab" GroupName="LookIn" HorizontalAlignment="Left" Margin="0,8,0,0" Checked="Criteria_Changed" />
            <RadioButton x:Name="LookInAll" GroupName="LookIn" HorizontalAlignment="Left" Margin="0,8,0,0" Checked="Criteria_Changed" />

            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="10,8" Margin="0,18,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" />
                    <TextBlock x:Name="Preview" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Paths are matched as the list shows them, so a relative path such as Links\Site.rvt has no drive or server name in it." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="CANCEL" Width="100" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="ReplaceButton" Content="REPLACE" Style="{StaticResource PrimaryButton}" MinWidth="110"
                        IsDefault="True" Click="Replace_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
