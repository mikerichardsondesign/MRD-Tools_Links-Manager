<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MRD-Tools</AssemblyName>
    <RootNamespace>MRDTools</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Version>9.1.0</Version>
    <Title>External Access Links Manager</Title>
    <Product>External Access Links Manager</Product>
    <Description>Review, repath, load and unload links in Revit projects without opening them</Description>
    <Company>Mike Richardson Design</Company>
    <Copyright>MikeRichardsonDesign 2026</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Revit loads the add-in from its own folder, so NuGet dependencies (EPPlus) must sit next to the DLL -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- packages\ is left over from the old packages.config restore. The SDK only excludes the current year's
         obj\R20xx\, so exclude all of obj\ or one year compiles another's generated AssemblyInfo. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);packages\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- One configuration per Revit year. Directory.Build.props turns the configuration into $(RevitVersion). -->
  <PropertyGroup>
    <Configurations>Debug R24;Debug R25;Debug R26;Debug R27;Release R24;Release R25;Release R26;Release R27</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);TRACE;REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2025">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2026">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2027">$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- The SDK only applies its Debug/Release defaults to configurations named exactly "Debug" or "Release" -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
  </ItemGroup>

  <!--
    On .NET 8+ EPPlus reads its settings through Microsoft.Extensions.Configuration.Json. Revit 2025 ships 7.0 of the
    core Configuration/Primitives assemblies but not the Json and file-provider ones, so pin the chain to 7.0: the
    copies shipped with the add-in then bind against Revit's own. Revit 2027 gets all of them from the ASP.NET Core
    shared framework it loads, so nothing extra is needed there.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="7.0.0" />
  </ItemGroup>

  <!-- The checks in tests\MRD-Tools.Checks drive the link model and windows directly -->
  <ItemGroup>
    <InternalsVisibleTo Include="MRD-Tools.Checks" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\MRD-Links.ico" LogicalName="MRDTools.MRD-Links.ico" />
    <None Update="MRD-Tools.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\MRD-Links-16x16.png" CopyToOutputDirectory="PreserveNewest" Link="MRD-Links-16x16.png" />
    <None Update="Resources\MRD-Links-32x32.png" CopyToOutputDirectory="PreserveNewest" Link="MRD-Links-32x32.png" />
  </ItemGroup>

  <Import Project="Deploy.targets" />

</Project>
